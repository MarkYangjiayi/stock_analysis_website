ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./data/quantify_local.db

EODHD_API_KEY=replace_me
EODHD_BASE_URL=https://eodhd.com/api
GEMINI_API_KEY=replace_me
FEISHU_WEBHOOK_URL=

# Required when ENVIRONMENT=production. Send it as X-API-Key to admin APIs.
ADMIN_API_KEY=replace_with_a_long_random_value
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
EXPENSIVE_REQUESTS_PER_MINUTE=10

# Background work runs in worker.py, never inside Uvicorn.
ENABLE_WS_MONITOR=false
WS_SYMBOLS=AAPL,NVDA,TSLA,ASTS
WS_WINDOW_SECONDS=300
WS_ALERT_THRESHOLD=0.015
WS_COOLDOWN_SECONDS=900

DATA_DIR=./data
RAW_DATA_DIR=./data/raw
BACKUP_DIR=./data/backups
COLD_START_HISTORY_DAYS=252
HISTORY_BACKFILL_CONCURRENCY=2
PIPELINE_MIN_PRICE_COVERAGE=0.95
PIPELINE_MIN_FUNDAMENTAL_COVERAGE=0.80
PIPELINE_MIN_UNIVERSE_COVERAGE=0.90
PIPELINE_MIN_PRICE_FACTOR_COVERAGE=0.80
PIPELINE_MIN_UNIVERSE_SIZE=100
PROFILE_MAX_STALENESS_DAYS=7
