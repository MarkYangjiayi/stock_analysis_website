ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./data/quantify_local.db

EODHD_API_KEY=replace_me
EODHD_BASE_URL=https://eodhd.com/api
# Official Treasury par-yield observations are cached on disk between requests.
TREASURY_YIELD_CACHE_HOURS=12

# DCF market assumptions. Refresh the risk-free rate/as-of date together.
# The equity-risk-premium convention matches GuruFocus's published 6% method.
VALUATION_RISK_FREE_RATE=0.04808
VALUATION_EQUITY_RISK_PREMIUM=0.06
VALUATION_FALLBACK_DEBT_SPREAD=0.015
VALUATION_FALLBACK_TAX_RATE=0.21
VALUATION_FALLBACK_FCF_GROWTH=0.05
VALUATION_TERMINAL_GROWTH_RATE=0.025
VALUATION_MARKET_ASSUMPTIONS_AS_OF=2026-09-09

DEEPSEEK_API_KEY=replace_me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_ENABLED=false
SEC_USER_AGENT=Your Company research@example.com
EARNINGS_QUALITY_AI_ENABLED=true
EARNINGS_QUALITY_TIMEOUT_SECONDS=120
EARNINGS_QUALITY_LEASE_SECONDS=180
EARNINGS_QUALITY_MAX_CONTEXT_CHARS=80000
FINANCIAL_FLOW_ENABLED=true
FINANCIAL_FLOW_ENRICHMENT_ENABLED=true
FINANCIAL_FLOW_TIMEOUT_SECONDS=120
FINANCIAL_FLOW_LEASE_SECONDS=180
FINANCIAL_FLOW_MAX_CONCURRENCY=1
FEISHU_WEBHOOK_URL=

# Cross-asset daily reports. New York time, DST-aware; delayed quotes usually
# need 15-20 minutes to reach the open/close. US holidays are skipped.
DAILY_REPORT_MORNING_HOUR=10
DAILY_REPORT_MORNING_MINUTE=0
DAILY_REPORT_CLOSE_HOUR=16
DAILY_REPORT_CLOSE_MINUTE=30
DAILY_REPORT_CORE_SYMBOLS=AAPL.US,MSFT.US,NVDA.US,AMZN.US,0700.HK,9988.HK,2330.TW,ASML.AS
DAILY_REPORT_INCLUDE_WATCHLIST=true
DAILY_REPORT_WATCHLIST_LIMIT=12
DAILY_REPORT_EVENTS_ENABLED=true

# Daily RSI(14) monitor. With no explicit symbols, it follows the server watchlist.
# Runs Tue-Sat at 04:30 America/New_York for the preceding US market session.
RSI_MONITOR_ENABLED=false
RSI_MONITOR_SYMBOLS=
RSI_MONITOR_OVERSOLD=30
RSI_MONITOR_OVERBOUGHT=70
RSI_MONITOR_REFRESH_CONCURRENCY=4

# Optional. If omitted in production, admin APIs return 503 while public reads remain available.
ADMIN_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
EXPENSIVE_REQUESTS_PER_MINUTE=3
TRUSTED_PROXY_IPS=127.0.0.1,::1,172.16.0.0/12
ANOMALY_MOVE_THRESHOLD_PCT=4.0
ANOMALY_RESULT_LIMIT=20
ANOMALY_ATTRIBUTION_CONCURRENCY=3
ANOMALY_ATTRIBUTION_TIMEOUT_SECONDS=30
ANOMALY_SCAN_TIMEOUT_SECONDS=90
ANOMALY_SCAN_LEASE_SECONDS=15
ANOMALY_NEWS_LOOKBACK_HOURS=24

# Background work runs in worker.py, never inside Uvicorn.
ENABLE_WS_MONITOR=false
WS_SYMBOLS=AAPL,NVDA,TSLA,ASTS
WS_WINDOW_SECONDS=300
WS_ALERT_THRESHOLD=0.015
WS_COOLDOWN_SECONDS=900

DATA_DIR=./data
RAW_DATA_DIR=./data/raw
BACKUP_DIR=./data/backups
COLD_START_HISTORY_DAYS=252
HISTORY_BACKFILL_CONCURRENCY=2
PIPELINE_MIN_PRICE_COVERAGE=0.95
PIPELINE_MIN_FUNDAMENTAL_COVERAGE=0.80
PIPELINE_REQUIRE_MULTIPLE_COVERAGE=true
PIPELINE_MIN_UNIVERSE_COVERAGE=0.90
PIPELINE_MIN_PRICE_FACTOR_COVERAGE=0.80
PIPELINE_MIN_UNIVERSE_SIZE=100
PROFILE_MAX_STALENESS_DAYS=7
# Refresh at most one cohort of paid full-fundamentals payloads per session.
SCREENER_FUNDAMENTAL_MAX_AGE_DAYS=7
SCREENER_FUNDAMENTAL_DAILY_REFRESH_LIMIT=600
# Index-level valuation (S&P 500 month-end P/E history). Production coverage
# first stays above the publication gate for every month in 2016.
INDEX_VALUATION_HISTORY_START=2016-01-01
PIPELINE_MIN_INDEX_VALUATION_COVERAGE=0.80
INDEX_VALUATION_MIN_MONTH_COVERAGE=0.90
INDEX_VALUATION_COMPUTE_CONCURRENCY=8
INDEX_VALUATION_SEC_TICKERS_PATH=./data/sec_mapping_cache/sec_company_tickers.json.gz

# Trending themes (题材热度). Jobs run in the worker, Tue-Sat 04:35-05:15 America/New_York.
# Master switch for every theme job, including the one-off bootstrap ~120 s after worker start.
THEMES_ENABLED=true
# Serve /api/v1/themes* without the admin key (default: admin-only).
THEMES_PUBLIC=false
# Alternate taxonomy YAML; empty uses services/themes/taxonomy/themes_v1.yaml.
THEME_TAXONOMY_PATH=
# Oldest UTC news day the attention backfill fetches (baselines need ~100 complete days).
THEME_NEWS_BACKFILL_START=2025-09-01
# Older missing news days fetched per run (~10 EODHD calls per day).
THEME_NEWS_BACKFILL_DAYS_PER_RUN=120
# Most recent complete UTC days refetched every run to absorb late articles.
THEME_NEWS_RECENT_REFRESH_DAYS=3
# 1,000-article pages per UTC day before the day is marked truncated (partial).
THEME_NEWS_MAX_PAGES_PER_DAY=20
# Days of headline evidence kept in news_items (counts are kept indefinitely).
THEME_NEWS_RETENTION_DAYS=45
# An article counts as "focused" when it tags at most this many US tickers.
THEME_NEWS_FOCUSED_MAX_SYMBOLS=5
# Timeout for one market-wide news page request.
THEME_NEWS_TIMEOUT_SECONDS=60
# Minimum proxy-ETF holding weight (%) for a holding to become a membership candidate.
THEME_MEMBERSHIP_MIN_ETF_WEIGHT_PCT=0.5
# Cap on description-keyword candidates per theme.
THEME_MEMBERSHIP_MAX_KEYWORD_CANDIDATES=40
# Candidates per DeepSeek verification call.
THEME_MEMBERSHIP_BATCH_SIZE=12
# Concurrent DeepSeek verification calls.
THEME_MEMBERSHIP_CONCURRENCY=3
# Timeout for one verification call (retried up to 3 times).
THEME_MEMBERSHIP_LLM_TIMEOUT_SECONDS=90
# Bootstrap re-runs membership when the latest publication is older than this.
THEME_MEMBERSHIP_MAX_AGE_DAYS=8
# Priced members a theme needs on a session to be ranked.
THEME_MIN_RANKABLE_MEMBERS=6
# Sessions scripts/backfill_theme_trends.py publishes by default.
THEME_BACKFILL_SESSIONS=120
# theme_trends gate: share of active member tickers priced on the target session.
PIPELINE_MIN_THEME_PRICE_COVERAGE=0.90
# theme_trends gate: rankable themes required on the target session.
PIPELINE_MIN_RANKABLE_THEMES=10
# Chinese "why it's moving" briefs at 05:05 (needs DEEPSEEK_API_KEY).
THEME_BRIEFS_ENABLED=true
# Top themes by rank that get a brief (plus newly emerging or stage-changed ones).
THEME_BRIEF_TOP_N=8
# Timeout for one brief generation call.
THEME_BRIEF_TIMEOUT_SECONDS=90
# Feishu digest of emerging / crowded / fading themes at 05:15 (needs FEISHU_WEBHOOK_URL).
THEME_ALERTS_ENABLED=true
# Saturday 08:30 new-theme proposals from movers outside every theme.
THEME_PROPOSALS_ENABLED=true
