ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./data/quantify_local.db

EODHD_API_KEY=replace_me
EODHD_BASE_URL=https://eodhd.com/api
DEEPSEEK_API_KEY=replace_me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_ENABLED=false
SEC_USER_AGENT=Your Company research@example.com
EARNINGS_QUALITY_AI_ENABLED=true
EARNINGS_QUALITY_TIMEOUT_SECONDS=120
EARNINGS_QUALITY_LEASE_SECONDS=180
EARNINGS_QUALITY_MAX_CONTEXT_CHARS=80000
FEISHU_WEBHOOK_URL=

# Optional. If omitted in production, admin APIs return 503 while public reads remain available.
ADMIN_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
EXPENSIVE_REQUESTS_PER_MINUTE=3
TRUSTED_PROXY_IPS=127.0.0.1,::1,172.16.0.0/12
ANOMALY_MOVE_THRESHOLD_PCT=4.0
ANOMALY_RESULT_LIMIT=20
ANOMALY_ATTRIBUTION_CONCURRENCY=3
ANOMALY_ATTRIBUTION_TIMEOUT_SECONDS=30
ANOMALY_SCAN_TIMEOUT_SECONDS=90
ANOMALY_SCAN_LEASE_SECONDS=15
ANOMALY_NEWS_LOOKBACK_HOURS=24

# Background work runs in worker.py, never inside Uvicorn.
ENABLE_WS_MONITOR=false
WS_SYMBOLS=AAPL,NVDA,TSLA,ASTS
WS_WINDOW_SECONDS=300
WS_ALERT_THRESHOLD=0.015
WS_COOLDOWN_SECONDS=900

DATA_DIR=./data
RAW_DATA_DIR=./data/raw
BACKUP_DIR=./data/backups
COLD_START_HISTORY_DAYS=252
HISTORY_BACKFILL_CONCURRENCY=2
PIPELINE_MIN_PRICE_COVERAGE=0.95
PIPELINE_MIN_FUNDAMENTAL_COVERAGE=0.80
PIPELINE_REQUIRE_MULTIPLE_COVERAGE=true
PIPELINE_MIN_UNIVERSE_COVERAGE=0.90
PIPELINE_MIN_PRICE_FACTOR_COVERAGE=0.80
PIPELINE_MIN_UNIVERSE_SIZE=100
PROFILE_MAX_STALENESS_DAYS=7
# Refresh at most one cohort of paid full-fundamentals payloads per session.
SCREENER_FUNDAMENTAL_MAX_AGE_DAYS=7
SCREENER_FUNDAMENTAL_DAILY_REFRESH_LIMIT=600
